# ══════════════════════════════════════════════════════════════════════════════
# Friday Assistant — Environment Variables
# Copy this file to .env and fill in all required values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Persona ───────────────────────────────────────────────────────────────────
ASSISTANT_NAME=Friday
YOUR_NAME=Alex

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+14155551234          # Your Twilio number
YOUR_PHONE_NUMBER=+14155550000            # Your personal number (SMS target)
ALLOWED_PHONE_NUMBERS=+14155550000        # Comma-separated; empty = allow all callers

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── ElevenLabs ───────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel (default). Browse: elevenlabs.io/voice-library
ELEVENLABS_MODEL_ID=eleven_flash_v2        # eleven_flash_v2 = fastest; eleven_multilingual_v2 = highest quality

# ── Deepgram (Speech-to-Text) ─────────────────────────────────────────────────
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=change-this-to-a-random-32-character-string
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_TASK_TOKEN=change-this-shared-secret   # Must match in voice service + n8n vars

# ── Public URL (your Railway / ngrok domain) ──────────────────────────────────
# Voice webhook: configure Twilio → https://<PUBLIC_URL>/twiml
# n8n webhook:   https://<PUBLIC_URL>/webhook/*
PUBLIC_URL=https://your-app.up.railway.app

# ── PostgreSQL (n8n database — only needed for docker-compose local dev) ──────
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-this-strong-password

# ── Google Calendar ───────────────────────────────────────────────────────────
# Create a service account at console.cloud.google.com, download the JSON key,
# and share your calendar with the service account email.
GOOGLE_CREDENTIALS_PATH=/data/google-credentials.json
GOOGLE_CALENDAR_ID=primary

# ── OpenWeatherMap (optional) ─────────────────────────────────────────────────
OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_LOCATION=New York

# ── Brave Search (optional — used by task-research n8n workflow) ──────────────
BRAVE_SEARCH_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Memory / Storage ──────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=/data/chromadb
FACTS_DB_PATH=/data/facts.sqlite
NOTES_DIR=/data/notes
MEMORY_TOP_K=5

# ── Scheduler ─────────────────────────────────────────────────────────────────
TIMEZONE=America/New_York
MORNING_BRIEFING_HOUR=7
MORNING_BRIEFING_MINUTE=0
EVENING_DIGEST_HOUR=18
EVENING_DIGEST_MINUTE=0
ENABLE_EVENING_DIGEST=false

# ── Service port (local dev only; Railway injects $PORT automatically) ─────────
SERVICE_PORT=8000
